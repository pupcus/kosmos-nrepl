{
 :deps
 {
  io.github.pupcus/kosmos {:git/tag "2026-10-31-R1"
                           :git/sha "5907830"}
  nrepl/nrepl {:mvn/version "1.8.0"}
  }

 :paths ["src"]

 :aliases
 {
  ;; make dev
  :dev {:extra-paths ["test" "dev-resources"]
        :extra-deps {cider/cider-nrepl             {:mvn/version "0.64.0"}
                     org.clojure/clojure           {:mvn/version "1.12.6"}
                     org.slf4j/slf4j-simple        {:mvn/version "2.0.20"}
                     refactor-nrepl/refactor-nrepl {:mvn/version "3.15.0"}}
        :main-opts ["-m" "nrepl.cmdline"
                    "--middleware" "[refactor-nrepl.middleware/wrap-refactor,cider.nrepl/cider-middleware]"]}

  ;; make test
  :test {:extra-paths ["test" "dev-resources"]
         :extra-deps {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                      org.slf4j/slf4j-simple {:mvn/version "2.0.20"}}
         :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]
         :main-opts [ "-m" "kaocha.runner"]}
  }
 }
